# Node.js 24+; copy to .env. Node loads it automatically; Docker Compose also reads it.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
DOCKER_PORT=3001
# Empty token disables admin APIs. Replace with a long random value.
ADMIN_TOKEN=
MAX_SUBMISSIONS_PER_MINUTE=20
MAX_SUBMISSIONS_PER_HOUR=200
# Comma-separated exact words; validation also rejects administrator-hidden words.
MODERATION_WORDS=
# Enable only behind a proxy which overwrites X-Forwarded-For.
TRUST_PROXY=0
